{
  "name": "stock-sector-library",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild && node scripts/prepare-hosting.mjs",
    "build:next": "next build",
    "convert:legacy": "node scripts/convert_legacy_library.mjs",
    "validate:data": "node scripts/validate_sector_data.mjs",
    "test:relevance": "node tests/relevance-score-contract.mjs",
    "test:stock-universe": "node tests/stock-universe-third-board-contract.mjs",
    "test:market-pagination": "node tests/reported-total-pagination-contract.mjs",
    "test:core-relevance": "node tests/core-relevance-score-contract.mjs",
    "test:automatic-core-modules": "node tests/automatic-core-modules-contract.mjs",
    "backfill:market": "node scripts/backfill_5minute_parquet.mjs",
    "backfill:market:range": "node scripts/backfill_5minute_parquet_range.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "duckdb": "^1.4.4",
    "hyparquet": "^1.26.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  }
}
